<% content_for :title, "Posts | Simple Blog" %>

<section class="space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-4 border-b border-zinc-200 pb-5">
    <div>
      <p class="text-sm font-medium uppercase tracking-wide text-emerald-700">The blog</p>
      <h1 class="mt-1 text-3xl font-semibold">Recent posts</h1>
    </div>
    <%= link_to "Write a post", new_post_path, class: "rounded bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800" %>
  </div>

  <% if @posts.any? %>
    <div class="divide-y divide-zinc-200">
      <% @posts.each do |post| %>
        <article class="py-6">
          <h2 class="text-xl font-semibold"><%= link_to post.title, post_path(post), class: "text-zinc-900 hover:text-emerald-700" %></h2>
          <p class="mt-1 text-sm text-zinc-600">By <%= link_to post.user.name, user_path(post.user), class: "font-medium text-emerald-700 hover:text-emerald-900" %></p>
          <p class="mt-3 leading-7 text-zinc-700"><%= truncate(post.content, length: 220) %></p>
          <%= link_to "Read post", post_path(post), class: "mt-3 inline-block text-sm font-medium text-emerald-700 hover:text-emerald-900" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="py-8">
      <p class="text-zinc-700">There are no posts yet.</p>
      <p class="mt-2 text-sm text-zinc-600">Create a user first, then write the first post.</p>
      <%= link_to "Add a user", new_user_path, class: "mt-4 inline-block text-sm font-medium text-emerald-700 hover:text-emerald-900" %>
    </div>
  <% end %>
</section>
