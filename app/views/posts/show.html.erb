<% content_for :title, "#{@post.title} | Simple Blog" %>

<article class="max-w-3xl">
  <p class="text-sm font-medium uppercase tracking-wide text-emerald-700">Blog post</p>
  <h1 class="mt-2 text-3xl font-semibold"><%= @post.title %></h1>
  <p class="mt-3 text-sm text-zinc-600">
    By <%= link_to @post.user.name, user_path(@post.user), class: "font-medium text-emerald-700 hover:text-emerald-900" %>
    <span aria-hidden="true">·</span>
    <%= @post.created_at.strftime("%B %d, %Y") %>
  </p>

  <div class="mt-8 whitespace-pre-line leading-8 text-zinc-800"><%= @post.content %></div>

  <div class="mt-10 flex flex-wrap items-center gap-4 border-t border-zinc-200 pt-5 text-sm">
    <%= link_to "Edit post", edit_post_path(@post), class: "font-medium text-emerald-700 hover:text-emerald-900" %>
    <%= button_to "Delete post", post_path(@post), method: :delete, class: "font-medium text-rose-700 hover:text-rose-900" %>
    <%= link_to "All posts", posts_path, class: "text-zinc-600 hover:text-zinc-900" %>
  </div>
</article>
