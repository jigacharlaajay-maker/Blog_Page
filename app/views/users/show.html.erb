<% content_for :title, "#{@user.name} | Simple Blog" %>

<section class="space-y-8">
  <header class="flex flex-wrap items-start justify-between gap-4 border-b border-zinc-200 pb-6">
    <div>
      <p class="text-sm font-medium uppercase tracking-wide text-emerald-700">User</p>
      <h1 class="mt-1 text-3xl font-semibold"><%= @user.name %></h1>
      <p class="mt-2 text-zinc-600"><%= @user.email %></p>
    </div>
    <div class="flex items-center gap-4 text-sm">
      <%= link_to "Edit user", edit_user_path(@user), class: "font-medium text-emerald-700 hover:text-emerald-900" %>
      <%= button_to "Delete user", user_path(@user), method: :delete, class: "font-medium text-rose-700 hover:text-rose-900" %>
    </div>
  </header>

  <div>
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-xl font-semibold">Posts by <%= @user.name %></h2>
      <%= link_to "Write a post", new_post_path, class: "text-sm font-medium text-emerald-700 hover:text-emerald-900" %>
    </div>
    <% if @posts.any? %>
      <ul class="mt-4 divide-y divide-zinc-200">
        <% @posts.each do |post| %>
          <li class="py-5">
            <h3><%= link_to post.title, post_path(post), class: "text-lg font-semibold text-zinc-900 hover:text-emerald-700" %></h3>
            <p class="mt-2 text-zinc-600"><%= truncate(post.content, length: 180) %></p>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-zinc-600">This user has not written any posts yet.</p>
    <% end %>
  </div>
</section>
