<%= form_with model: user, class: "space-y-5" do |form| %>
  <% if user.errors.any? %>
    <div role="alert" class="border-l-4 border-rose-600 bg-rose-50 p-4 text-sm text-rose-900">
      <p class="font-semibold">Please fix these errors:</p>
      <ul class="mt-2 list-inside list-disc">
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "mb-1 block text-sm font-medium text-zinc-800" %>
    <%= form.text_field :name, required: true, class: "w-full rounded border border-zinc-300 bg-white px-3 py-2 focus:border-emerald-700 focus:outline-none" %>
  </div>

  <div>
    <%= form.label :email, class: "mb-1 block text-sm font-medium text-zinc-800" %>
    <%= form.email_field :email, required: true, class: "w-full rounded border border-zinc-300 bg-white px-3 py-2 focus:border-emerald-700 focus:outline-none" %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.submit class: "rounded bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800" %>
    <%= link_to "Cancel", users_path, class: "text-sm text-zinc-600 hover:text-zinc-900" %>
  </div>
<% end %>
